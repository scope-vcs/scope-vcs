SCOPE_DEV_USER_EMAIL=you@example.com
SCOPE_DEV_USER_HANDLE=you
DATABASE_URL=postgres://scope:scope@127.0.0.1:5432/scope_dev
SCOPE_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/scope_test

# Optional. Leave unset to disable server-side product analytics.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Optional. Leave unset and invite emails fail at once; owners copy links instead.
SCOPE_RESEND_API_KEY=

# Optional. Deletes the Clerk users of deleted accounts. Leave unset and their
# Clerk deletions stay queued, retried until a key is set; until then those
# Clerk users cannot sign back in.
CLERK_SECRET_KEY=

# Optional. The Scope GitHub App that connects repositories to GitHub for
# request checks. Set all six or none; a partial set stops the API at startup.
# Registration settings are in docs/github-app.md.
SCOPE_GITHUB_APP_ID=
SCOPE_GITHUB_APP_SLUG=
SCOPE_GITHUB_APP_PRIVATE_KEY=
SCOPE_GITHUB_APP_CLIENT_ID=
SCOPE_GITHUB_APP_CLIENT_SECRET=
SCOPE_GITHUB_WEBHOOK_SECRET=
