{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "/worker/**",
      "/crates/**",
      "/Cargo.toml",
      "/Cargo.lock",
      "/rust-toolchain.toml"
    ]
  },
  "deploy": {
    "startCommand": "exec ./bin/scope-worker",
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 60,
    "overlapSeconds": "30",
    "drainingSeconds": "30"
  }
}
