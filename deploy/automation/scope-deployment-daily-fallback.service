[Unit]
Description=Recover a missed T3 daily deployment start
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/scope-vcs
ExecStart=/usr/bin/python3 -B %h/.local/share/scope-automation/bounded-release-supervisor/deployment_session.py trigger daily-fallback
TimeoutStartSec=90
UMask=0077
