#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMAND="${1:-all}"
source "$ROOT/dev/dotenv.sh"

usage() {
  cat <<'EOF'
usage: ./dev/check [all|guardrails|rust|cli|web|analyzer|ops|smoke]

  all         run every non-browser check group (default)
  guardrails  check source size, crate boundaries, and replicated toolchain pins
  rust        format, test, and lint the main Rust workspace
  cli         format, test, lint, and release-build the standalone CLI workspace
  web         test, check, and build the web application
  analyzer    install the locked analyzer dependencies and run its tests
  ops         test deployment orchestration and benchmark scripts
  smoke       run the browser smoke suite against an already running local stack
EOF
}

guardrails() { ./dev/checks/policy; }
rust() { ./dev/checks/backend with-api; }
cli() { ./dev/checks/cli; }
web() { ./dev/checks/web; }
analyzer() { ./dev/checks/dependency-analyzer; }
ops() { ./dev/checks/ops; }

smoke() {
  local smoke_repo="${SCOPE_SMOKE_REPO:-}"
  if [[ -z "$smoke_repo" ]]; then
    local handle
    handle="$(read_dotenv_value "$ROOT/.env.local" "SCOPE_DEV_USER_HANDLE")"
    if [[ -n "$handle" ]]; then
      smoke_repo="$handle/public-demo"
    fi
  fi
  env ${smoke_repo:+SCOPE_SMOKE_REPO="$smoke_repo"} ./dev/checks/integration web
}

cd "$ROOT"

case "$COMMAND" in
  all)
    guardrails
    rust
    cli
    web
    analyzer
    ops
    ;;
  guardrails) guardrails ;;
  rust) rust ;;
  cli) cli ;;
  web) web ;;
  analyzer) analyzer ;;
  ops) ops ;;
  smoke) smoke ;;
  help|-h|--help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
