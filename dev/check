#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMAND="${1:-all}"
source "$ROOT/dev/dotenv.sh"

usage() {
  cat <<'EOF'
usage: ./dev/check [all|guardrails|rust|contract|cli|web|ops|smoke]

  all         run every non-browser check group this checkout includes (default)
  guardrails  check source rules, crate boundaries, and developer tooling
  rust        format, test, and lint the main Rust workspace
  contract    compare the generated API TypeScript contract with the checked-in files
  cli         format, test, and lint the CLI workspace, then build and check its bundle
  web         test, check, and build the web application
  ops         test deployment orchestration, CI structure, and benchmark scripts; needs deploy/
  smoke       run the browser component suite, then the browser smoke suite against an already running local stack
EOF
}

guardrails() { ./dev/checks/policy; }
rust() { ./dev/checks/backend; }
contract() { ./dev/checks/contract; }
cli() { ./dev/checks/cli; ./dev/checks/cli-bundle; }
web() { ./dev/checks/web; }
includes_operations() { [[ -d "$ROOT/deploy/scripts" ]]; }

ops() {
  if ! includes_operations; then
    echo "operations checks need deploy/, which this checkout does not include" >&2
    return 1
  fi
  ./dev/checks/ops
}

smoke() {
  local smoke_repo="${SCOPE_SMOKE_REPO:-}"
  if [[ -z "$smoke_repo" ]]; then
    local handle
    handle="$(read_dotenv_value "$ROOT/.env.local" "SCOPE_DEV_USER_HANDLE")"
    if [[ -n "$handle" ]]; then
      smoke_repo="$handle/public-demo"
    fi
  fi
  ./dev/checks/web-components
  env ${smoke_repo:+SCOPE_SMOKE_REPO="$smoke_repo"} ./dev/checks/integration web
}

cd "$ROOT"

case "$COMMAND" in
  all)
    guardrails
    rust
    contract
    cli
    web
    if includes_operations; then
      ops
    else
      echo "Skipped operations checks: this checkout does not include deploy/."
    fi
    ;;
  guardrails) guardrails ;;
  rust) rust ;;
  contract) contract ;;
  cli) cli ;;
  web) web ;;
  ops) ops ;;
  smoke) smoke ;;
  help|-h|--help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
