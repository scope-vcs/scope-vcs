#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: ./dev/scope-dev [command]

Supported local-development entrypoint.

commands:
  doctor  validate required tools, local environment, and Clerk development keys
  up      migrate and seed Postgres, then start API, workers, media, and web
  down    stop processes started by this script
  status  show owned process and HTTP readiness state (default)
  reset   stop owned processes and remove .scope/dev and .tmp/local-dev
  bench   run the short deployed-system benchmark against the running local API
  help    show this help

required configuration:
  .env.local       DATABASE_URL, SCOPE_DEV_USER_EMAIL, optional SCOPE_DEV_USER_HANDLE
  web/.env.local   VITE_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY using matching
                   Clerk development keys

local services:
  web  http://localhost:3000
  API  http://localhost:8080
  media gateway  http://localhost:8083
  media worker health  http://localhost:8084

The local API uses filesystem object storage under .scope/dev. Startup strips
inherited Railway and bucket variables and rejects production-looking Clerk or
database settings. reset refuses to remove data outside this repository.

After `up`, run `./dev/check smoke` for the anonymous browser smoke suite. See
bench/README.md for benchmark controls beyond the short local defaults.
EOF
}

COMMAND="${1:-status}"
case "$COMMAND" in
  bench|doctor|up|down|status|reset) ;;
  help|-h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="$ROOT/.tmp/local-dev"
DATA_DIR="$ROOT/.scope/dev"
OBJECT_DIR="$DATA_DIR/objects"
KEY_FILE="$DATA_DIR/object-key.txt"
MEDIA_KEY_FILE="$DATA_DIR/media-key.txt"
MEDIA_PRIVATE_KEY_FILE="$DATA_DIR/media-grant-private.pem"
MEDIA_PUBLIC_KEY_FILE="$DATA_DIR/media-grant-public.pem"
MEDIA_OBJECT_DIR="$DATA_DIR/media-objects"
LOCAL_CARGO_TARGET_DIR=""
LOCAL_WEB_ORIGIN="http://localhost:3000"
LOCAL_API_ORIGIN="http://localhost:8080"
PUBLIC_HOST="${SCOPE_DEV_PUBLIC_HOST:-}"

if [[ -z "$PUBLIC_HOST" ]] && command -v tailscale >/dev/null 2>&1; then
  PUBLIC_HOST="$(tailscale ip -4 2>/dev/null | head -n 1 || true)"
fi
PUBLIC_HOST="${PUBLIC_HOST:-localhost}"
PUBLIC_WEB_ORIGIN="${SCOPE_DEV_PUBLIC_WEB_ORIGIN:-http://$PUBLIC_HOST:3000}"
PUBLIC_API_ORIGIN="${SCOPE_DEV_PUBLIC_API_ORIGIN:-http://$PUBLIC_HOST:8080}"
CLERK_AUTHORIZED_PARTIES_VALUE="$LOCAL_WEB_ORIGIN"
if [[ "$PUBLIC_WEB_ORIGIN" != "$LOCAL_WEB_ORIGIN" ]]; then
  CLERK_AUTHORIZED_PARTIES_VALUE="$CLERK_AUTHORIZED_PARTIES_VALUE,$PUBLIC_WEB_ORIGIN"
fi

if [[ -d "$HOME/.local/share/scope-vcs-tools/node-24/bin" ]]; then
  export PATH="$HOME/.local/share/scope-vcs-tools/node-24/bin:$PATH"
fi
if [[ -d "$HOME/.cargo/bin" ]]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

ensure_dir() {
  mkdir -p "$1"
}

read_dotenv_value() {
  local path="$1"
  local key="$2"
  [[ -f "$path" ]] || return 0

  awk -v key="$key" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    {
      split($0, parts, "=")
      name = parts[1]
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
      if (name != key) {
        next
      }
      value = substr($0, index($0, "=") + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if ((substr(value, 1, 1) == "\"" && substr(value, length(value), 1) == "\"") ||
          (substr(value, 1, 1) == "'"'"'" && substr(value, length(value), 1) == "'"'"'")) {
        value = substr(value, 2, length(value) - 2)
      }
      print value
      exit
    }
  ' "$path"
}

get_clerk_issuer() {
  local publishable_key payload mod clerk_host
  publishable_key="$(read_dotenv_value "$ROOT/web/.env.local" "VITE_CLERK_PUBLISHABLE_KEY")"
  if [[ -z "$publishable_key" ]]; then
    echo "web/.env.local must define VITE_CLERK_PUBLISHABLE_KEY" >&2
    exit 1
  fi
  if [[ "$publishable_key" != pk_test_* ]]; then
    echo "local dev requires a Clerk development publishable key (pk_test_)" >&2
    exit 1
  fi

  payload="${publishable_key#pk_test_}"
  payload="${payload//_/\/}"
  payload="${payload//-/+}"
  mod=$(( ${#payload} % 4 ))
  if [[ "$mod" -eq 2 ]]; then
    payload="${payload}=="
  elif [[ "$mod" -eq 3 ]]; then
    payload="${payload}="
  fi

  if ! clerk_host="$(printf '%s' "$payload" | base64 --decode 2>/dev/null)"; then
    echo "VITE_CLERK_PUBLISHABLE_KEY is not valid base64url" >&2
    exit 1
  fi
  clerk_host="${clerk_host%$}"
  if [[ "$clerk_host" != *.clerk.accounts.dev ]]; then
    echo "local dev Clerk issuer must end with .clerk.accounts.dev, got $clerk_host" >&2
    exit 1
  fi
  printf 'https://%s\n' "$clerk_host"
}

get_dev_user_email() {
  local email
  email="$(read_dotenv_value "$ROOT/.env.local" "SCOPE_DEV_USER_EMAIL")"
  if [[ -z "$email" ]]; then
    echo "root .env.local must define SCOPE_DEV_USER_EMAIL for seeded local repos" >&2
    exit 1
  fi
  printf '%s\n' "$email"
}

get_dev_user_handle() {
  read_dotenv_value "$ROOT/.env.local" "SCOPE_DEV_USER_HANDLE"
}

local_database_url() {
  local value
  value="${DATABASE_URL:-}"
  if [[ -z "$value" ]]; then
    value="$(read_dotenv_value "$ROOT/.env.local" "DATABASE_URL")"
  fi
  printf '%s\n' "$value"
}

get_object_key() {
  ensure_dir "$DATA_DIR"
  if [[ ! -f "$KEY_FILE" ]]; then
    openssl rand -base64 32 > "$KEY_FILE"
  fi
  tr -d '\r\n' < "$KEY_FILE"
}

ensure_media_keys() {
  ensure_dir "$DATA_DIR"
  if [[ ! -f "$MEDIA_KEY_FILE" ]]; then
    openssl rand -base64 32 > "$MEDIA_KEY_FILE"
  fi
  if [[ ! -f "$MEDIA_PRIVATE_KEY_FILE" || ! -f "$MEDIA_PUBLIC_KEY_FILE" ]]; then
    rm -f -- "$MEDIA_PRIVATE_KEY_FILE" "$MEDIA_PUBLIC_KEY_FILE"
    openssl genpkey -algorithm ED25519 -out "$MEDIA_PRIVATE_KEY_FILE"
    openssl pkey -in "$MEDIA_PRIVATE_KEY_FILE" -pubout -out "$MEDIA_PUBLIC_KEY_FILE"
  fi
  chmod 0600 "$MEDIA_KEY_FILE" "$MEDIA_PRIVATE_KEY_FILE" "$MEDIA_PUBLIC_KEY_FILE"
}

assert_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "$1 is required for local dev" >&2
    exit 1
  fi
}

port_owner() {
  local port="$1"
  ss -H -ltnp "sport = :$port" 2>/dev/null |
    sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' |
    head -n 1
}

assert_port_free() {
  local port="$1"
  local name="$2"
  local owner
  owner="$(port_owner "$port")"
  if [[ -n "$owner" ]]; then
    echo "$name port $port is already in use by PID $owner" >&2
    exit 1
  fi
}

stop_owned_processes() {
  local service
  for service in media-worker media worker api web; do
    python3 "$ROOT/dev/local-process.py" stop "$STATE_DIR/$service.pid"
  done
}

start_service() {
  local service="$1"
  setsid "$STATE_DIR/$service.sh" > "$STATE_DIR/$service.out.log" 2> "$STATE_DIR/$service.err.log" &
  python3 "$ROOT/dev/local-process.py" record "$STATE_DIR/$service.pid" "$!"
}

# Every backend runner starts with the same local database and environment boundary.
write_backend_runner() {
  local runner="$1" database_url
  database_url="$(local_database_url)"
  [[ -n "$database_url" ]] || { echo "DATABASE_URL is required for local development" >&2; exit 1; }
  cat > "$runner" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd "$ROOT"
while IFS='=' read -r name _; do
  [[ "\$name" == RAILWAY_* ]] && unset "\$name"
  [[ "\$name" == SCOPE_BUCKET_* ]] && unset "\$name"
  [[ "\$name" == SCOPE_MEDIA_BUCKET_* ]] && unset "\$name"
done < <(env)
EOF
  printf 'export DATABASE_URL=%q\n' "$database_url" >> "$runner"
  chmod +x "$runner"
}

write_api_runner() {
  local issuer="$1" dev_email="$2" dev_handle="$3" object_key="$4"
  local runner="$STATE_DIR/api.sh"
  write_backend_runner "$runner"
  cat >> "$runner" <<EOF
export SCOPE_ENV="local"
export SCOPE_OBJECT_STORE="filesystem"
export SCOPE_DATA_DIR="$DATA_DIR"
export SCOPE_OBJECT_STORE_DIR="$OBJECT_DIR"
export SCOPE_OBJECT_ENCRYPTION_KEY="$object_key"
export PORT="8080"
export SCOPE_APP_ORIGIN="$LOCAL_WEB_ORIGIN"
export SCOPE_API_PUBLIC_URL="$LOCAL_API_ORIGIN"
export SCOPE_GIT_PUBLIC_URL="$LOCAL_API_ORIGIN"
export SCOPE_MEDIA_PUBLIC_URL="http://localhost:8083"
export SCOPE_MEDIA_GRANT_PRIVATE_KEY="\$(cat "$MEDIA_PRIVATE_KEY_FILE")"
export CLERK_ISSUER="$issuer"
export CLERK_JWKS_URL="$issuer/.well-known/jwks.json"
export CLERK_AUTHORIZED_PARTIES="$CLERK_AUTHORIZED_PARTIES_VALUE"
export SCOPE_DEV_USER_EMAIL="$dev_email"
EOF
  if [[ -n "$dev_handle" ]]; then
    printf 'export SCOPE_DEV_USER_HANDLE=%q\n' "$dev_handle" >> "$runner"
  else
    printf 'unset SCOPE_DEV_USER_HANDLE\n' >> "$runner"
  fi
  cat >> "$runner" <<'EOF'
if [[ "${SCOPE_DEV_MAINTENANCE_ONLY:-0}" == "1" ]]; then
EOF
  printf '  exec %q apply\n' "$LOCAL_CARGO_TARGET_DIR/debug/scope-maintenance" >> "$runner"
  cat >> "$runner" <<'EOF'
fi
EOF
  printf 'exec %q\n' "$LOCAL_CARGO_TARGET_DIR/debug/api" >> "$runner"
}

write_media_runner() {
  local runner="$STATE_DIR/media.sh"
  write_backend_runner "$runner"
  cat >> "$runner" <<EOF
export PORT="8083"
export SCOPE_MEDIA_OBJECT_STORE="filesystem"
export SCOPE_MEDIA_OBJECT_STORE_DIR="$MEDIA_OBJECT_DIR"
export SCOPE_MEDIA_ENCRYPTION_KEY="\$(tr -d '\\r\\n' < "$MEDIA_KEY_FILE")"
export SCOPE_MEDIA_GRANT_PUBLIC_KEY="\$(cat "$MEDIA_PUBLIC_KEY_FILE")"
export SCOPE_MEDIA_ALLOWED_ORIGIN="$LOCAL_WEB_ORIGIN"
EOF
  printf 'exec %q\n' "$LOCAL_CARGO_TARGET_DIR/debug/scope-media-service" >> "$runner"
}

write_media_worker_runner() {
  local runner="$STATE_DIR/media-worker.sh"
  write_backend_runner "$runner"
  cat >> "$runner" <<EOF
export PORT="8084"
export SCOPE_MEDIA_WORKER_ID="local-dev-media-worker"
export SCOPE_MEDIA_OBJECT_STORE="filesystem"
export SCOPE_MEDIA_OBJECT_STORE_DIR="$MEDIA_OBJECT_DIR"
export SCOPE_MEDIA_ENCRYPTION_KEY="\$(tr -d '\\r\\n' < "$MEDIA_KEY_FILE")"
EOF
  printf 'exec %q\n' "$LOCAL_CARGO_TARGET_DIR/debug/scope-media-worker" >> "$runner"
}

write_worker_runner() {
  local runner="$STATE_DIR/worker.sh" object_key
  object_key="$(get_object_key)"
  write_backend_runner "$runner"
  cat >> "$runner" <<EOF
export SCOPE_WORKER_ID="local-dev-worker"
export SCOPE_OBJECT_STORE="filesystem"
export SCOPE_DATA_DIR="$DATA_DIR"
export SCOPE_OBJECT_STORE_DIR="$OBJECT_DIR"
export SCOPE_OBJECT_ENCRYPTION_KEY="$object_key"
EOF
  printf 'exec %q\n' "$LOCAL_CARGO_TARGET_DIR/debug/worker" >> "$runner"
}

write_web_runner() {
  local runner="$STATE_DIR/web.sh"

  cat > "$runner" <<EOF
#!/usr/bin/env bash
set -euo pipefail
cd "$ROOT/web"
while IFS='=' read -r name _; do
  [[ "\$name" == RAILWAY_* ]] && unset "\$name"
done < <(env)
export SCOPE_API_INTERNAL_URL="http://localhost:8080"
export SCOPE_API_PUBLIC_URL="$PUBLIC_API_ORIGIN"
export VITE_SCOPE_WEB_FORCE_SIGNED_OUT="${VITE_SCOPE_WEB_FORCE_SIGNED_OUT:-1}"
exec pnpm dev --host 0.0.0.0
EOF
  chmod +x "$runner"
}

prepare_local_schema() {
  local issuer dev_email dev_handle object_key
  issuer="$(get_clerk_issuer)"
  dev_email="$(get_dev_user_email)"
  dev_handle="$(get_dev_user_handle)"
  object_key="$(get_object_key)"
  write_api_runner "$issuer" "$dev_email" "$dev_handle" "$object_key"
  SCOPE_DEV_MAINTENANCE_ONLY=1 "$STATE_DIR/api.sh"
}

build_local_services() {
  LOCAL_CARGO_TARGET_DIR="$(
    cd "$ROOT"
    cargo metadata --locked --no-deps --format-version 1 |
      node -e 'const fs = require("node:fs"); process.stdout.write(JSON.parse(fs.readFileSync(0, "utf8")).target_directory)'
  )"
  (
    cd "$ROOT"
    cargo build --locked --features api/local-dev \
      -p api \
      -p worker \
      -p scope-media-service \
      -p scope-media-worker
  )
  local binary
  for binary in api scope-maintenance worker scope-media-service scope-media-worker; do
    if [[ ! -x "$LOCAL_CARGO_TARGET_DIR/debug/$binary" ]]; then
      echo "local build did not produce $LOCAL_CARGO_TARGET_DIR/debug/$binary" >&2
      exit 1
    fi
  done
}

wait_http() {
  local url="$1"
  local seconds="$2"
  local deadline=$((SECONDS + seconds))
  while (( SECONDS < deadline )); do
    if curl -fsS --max-time 2 "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

doctor() {
  assert_command cargo
  assert_command curl
  assert_command git
  assert_command node
  assert_command openssl
  assert_command pnpm
  assert_command python3
  assert_command setsid
  assert_command ss
  assert_command "${SCOPE_MEDIA_FFMPEG:-ffmpeg}"
  assert_command "${SCOPE_MEDIA_FFPROBE:-ffprobe}"
  assert_command "${SCOPE_MEDIA_HEIF_CONVERT:-heif-convert}"
  assert_command "${SCOPE_MEDIA_HEIF_INFO:-heif-info}"

  local issuer dev_email secret_key
  issuer="$(get_clerk_issuer)"
  dev_email="$(get_dev_user_email)"
  if [[ "${SCOPE_DEV_HEADLESS_E2E:-0}" != "1" ]]; then
    secret_key="$(read_dotenv_value "$ROOT/web/.env.local" "CLERK_SECRET_KEY")"
    if [[ -z "$secret_key" || "$secret_key" != sk_test_* ]]; then
      echo "web/.env.local must define a Clerk development secret key (sk_test_)" >&2
      exit 1
    fi
  fi

  echo "doctor ok"
  echo "metadata: postgres"
  echo "clerk issuer: $issuer"
  echo "seed user: $dev_email"
  echo "api: $LOCAL_API_ORIGIN"
  echo "web: $LOCAL_WEB_ORIGIN"
  if [[ "$PUBLIC_HOST" != "localhost" ]]; then
    echo "tailscale api: $PUBLIC_API_ORIGIN"
    echo "tailscale web: $PUBLIC_WEB_ORIGIN"
  fi
}

mint_bench_auth_token() {
  local api_origin="$1"
  curl -fsS --max-time 3 -X POST "$api_origin/v1/dev/bench/cli-session" \
    | node -e '
let input = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => {
  input += chunk;
});
process.stdin.on("end", () => {
  try {
    const body = JSON.parse(input);
    if (typeof body.session_token !== "string" || !body.session_token.startsWith("scope_cli_")) {
      process.exit(1);
    }
    process.stdout.write(body.session_token);
  } catch {
    process.exit(1);
  }
});
'
}

bench() {
  assert_command curl
  assert_command git
  assert_command node

  local bench_api_origin
  bench_api_origin="${SCOPE_BENCH_API_URL:-$LOCAL_API_ORIGIN}"
  bench_api_origin="${bench_api_origin%/}"

  if ! wait_http "$bench_api_origin/readyz" 5; then
    echo "api is not ready at $bench_api_origin; run ./dev/scope-dev up first or set SCOPE_BENCH_API_URL" >&2
    exit 1
  fi

  local dev_email dev_handle
  dev_email="$(get_dev_user_email)"
  dev_handle="$(get_dev_user_handle)"

  local bench_auth_token
  bench_auth_token="${SCOPE_BENCH_AUTH_TOKEN:-}"
  if [[ -z "$bench_auth_token" ]]; then
    if ! bench_auth_token="$(mint_bench_auth_token "$bench_api_origin" 2>/dev/null)"; then
      bench_auth_token=""
      echo "warning: could not mint a local benchmark CLI session; authenticated benchmark cases may be skipped" >&2
    fi
  fi

  SCOPE_BENCH_API_URL="$bench_api_origin" \
  SCOPE_BENCH_AUTH_TOKEN="$bench_auth_token" \
    SCOPE_DEV_USER_EMAIL="${SCOPE_DEV_USER_EMAIL:-$dev_email}" \
    SCOPE_DEV_USER_HANDLE="${SCOPE_DEV_USER_HANDLE:-$dev_handle}" \
    SCOPE_LOAD_WORKLOADS="${SCOPE_LOAD_WORKLOADS:-warm-fetch,full-clone,tree-read,blob-read,history-read,mixed,consistency}" \
    SCOPE_LOAD_STAGES="${SCOPE_LOAD_STAGES:-1,2}" \
    SCOPE_LOAD_STAGE_SECONDS="${SCOPE_LOAD_STAGE_SECONDS:-5}" \
    SCOPE_LOAD_CONFIRM_SECONDS="${SCOPE_LOAD_CONFIRM_SECONDS:-0}" \
    SCOPE_LOAD_HISTORY_DEPTHS="${SCOPE_LOAD_HISTORY_DEPTHS:-1,8}" \
    SCOPE_LOAD_CHURN_REPOS="${SCOPE_LOAD_CHURN_REPOS:-2}" \
    SCOPE_LOAD_MIXED_REPOS="${SCOPE_LOAD_MIXED_REPOS:-2}" \
    node "$ROOT/bench/railway-load.mjs"
}

up() {
  doctor >/dev/null
  stop_owned_processes
  assert_port_free 8080 "api"
  assert_port_free 8083 "media gateway"
  assert_port_free 8084 "media worker health"
  if [[ "${SCOPE_DEV_HEADLESS_E2E:-0}" != "1" ]]; then
    assert_port_free 3000 "web"
  fi
  ensure_dir "$STATE_DIR"
  ensure_dir "$DATA_DIR"
  ensure_dir "$MEDIA_OBJECT_DIR"
  ensure_media_keys
  local service
  for service in api web worker media media-worker; do
    rm -f -- "$STATE_DIR/$service.out.log" "$STATE_DIR/$service.err.log"
  done
  build_local_services
  prepare_local_schema
  start_service api
  if ! wait_http "http://localhost:8080/readyz" 45; then
    echo "api did not become ready; see $STATE_DIR/api.err.log" >&2
    exit 1
  fi
  write_worker_runner
  start_service worker
  write_media_runner
  start_service media
  if ! wait_http "http://localhost:8083/healthz" 90; then
    echo "media gateway did not become ready; see $STATE_DIR/media.err.log" >&2
    exit 1
  fi
  write_media_worker_runner
  start_service media-worker
  if ! wait_http "http://localhost:8084/healthz" 90; then
    echo "media worker did not become ready; see $STATE_DIR/media-worker.err.log" >&2
    exit 1
  fi
  if [[ "${SCOPE_DEV_HEADLESS_E2E:-0}" != "1" ]]; then
    write_web_runner
    start_service web
    if ! wait_http "http://localhost:3000" 180; then
      echo "web did not become ready; see $STATE_DIR/web.err.log" >&2
      exit 1
    fi
  fi
  status
}

status() {
  echo "api process: $(python3 "$ROOT/dev/local-process.py" status "$STATE_DIR/api.pid")"
  echo "worker process: $(python3 "$ROOT/dev/local-process.py" status "$STATE_DIR/worker.pid")"
  echo "media process: $(python3 "$ROOT/dev/local-process.py" status "$STATE_DIR/media.pid")"
  echo "media worker process: $(python3 "$ROOT/dev/local-process.py" status "$STATE_DIR/media-worker.pid")"
  echo "web process: $(python3 "$ROOT/dev/local-process.py" status "$STATE_DIR/web.pid")"
  if body="$(curl -fsS --max-time 3 "http://localhost:8080/readyz" 2>/dev/null)"; then
    echo "api readyz: $body"
  else
    echo "api readyz: unavailable"
  fi
  if body="$(curl -fsS --max-time 3 "http://localhost:8083/healthz" 2>/dev/null)"; then
    echo "media healthz: $body"
  else
    echo "media healthz: unavailable"
  fi
  if body="$(curl -fsS --max-time 3 "http://localhost:8084/healthz" 2>/dev/null)"; then
    echo "media worker healthz: $body"
  else
    echo "media worker healthz: unavailable"
  fi
  if code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "http://localhost:3000" 2>/dev/null)"; then
    echo "web: HTTP $code"
  else
    echo "web: unavailable"
  fi
}

reset() {
  local target resolved_target resolved_root
  resolved_root="$(realpath -m "$ROOT")"
  for target in "$DATA_DIR" "$STATE_DIR"; do
    resolved_target="$(realpath -m "$target")"
    if [[ "$resolved_target" != "$resolved_root"/* ]]; then
      echo "refusing to remove data outside repo: $resolved_target" >&2
      exit 1
    fi
  done
  stop_owned_processes
  rm -rf -- "$DATA_DIR" "$STATE_DIR"
  echo "local dev state reset"
}

case "$COMMAND" in
  bench) bench ;;
  doctor) doctor ;;
  up) up ;;
  down) stop_owned_processes; echo "local dev stopped" ;;
  status) status ;;
  reset) reset ;;
esac
