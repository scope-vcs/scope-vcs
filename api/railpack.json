{
  "$schema": "https://schema.railpack.com",
  "provider": "rust",
  "steps": {
    "build": {
      "commands": [
        "cargo build --release --locked -p api && mkdir -p bin && cp target/release/api bin/scope-vcs",
        "cp LICENSE NOTICE legal/third-party-rust.txt bin/"
      ]
    }
  },
  "deploy": {
    "aptPackages": ["...", "git"]
  }
}
