# Required matching Clerk development keys for `./dev/scope-dev`.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional hostname for remote development access, such as a Tailscale DNS name.
SCOPE_WEB_ALLOWED_HOST=

# Optional runtime analytics. Collection stays disabled unless environment, origin,
# and token are set and the request origin and Railway environment match this policy.
# Use `test` with a test-project token outside production. The project token is public;
# release is injected into built deployments and may be blank for local testing.
SCOPE_ANALYTICS_ENVIRONMENT=
SCOPE_ANALYTICS_ORIGIN=
SCOPE_ANALYTICS_RELEASE=
POSTHOG_PROJECT_TOKEN=
