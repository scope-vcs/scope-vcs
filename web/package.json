{
  "name": "@scope/web",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build-review-diff-worker.mjs && pnpm check:diff-worker-bundle && SCOPE_REQUIRE_BUILT_MANIFEST=1 node --test smoke/server-functions.spec.mjs",
    "check": "pnpm typecheck && pnpm check:resource-boundary && pnpm check:hooks && pnpm check:conventions && pnpm check:advisories",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "check:diff-worker-bundle": "node scripts/check-review-diff-worker-bundle.mjs",
    "check:resource-boundary": "node --test scripts/resource-boundary.test.mjs && node scripts/check-resource-boundary.mjs",
    "generate:api-contract": "node scripts/generate-api-contract.mjs",
    "test": "node scripts/prepare-test-output.mjs && tsc -p tsconfig.test.json && TZ=UTC node --test \".test-output/**/*.test.js\"",
    "test:smoke": "node --test \"smoke/**/*.spec.mjs\"",
    "typecheck": "tsc --noEmit",
    "check:hooks": "node --test scripts/check-hooks.test.mjs && oxlint -c .oxlintrc.json src",
    "check:advisories": "pnpm audit --audit-level high",
    "check:conventions": "node --test scripts/conventions.test.mjs && node scripts/check-conventions.mjs"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.5.15",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/commit-mono": "5.3.0",
    "@pierre/diffs": "1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "github-slugger": "2.0.0",
    "lucide-react": "^1.46.0",
    "mdast-util-from-markdown": "2.0.3",
    "mermaid": "12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "8.20.0",
    "nitro": "^3.0.260903-beta",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "oxlint": "1.82.0",
    "@babel/parser": "7.29.7"
  }
}
