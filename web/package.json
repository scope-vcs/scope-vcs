{
  "name": "@scope/web",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build-review-diff-worker.mjs && pnpm check:diff-worker-bundle && SCOPE_REQUIRE_BUILT_MANIFEST=1 node --test smoke/server-functions.spec.mjs",
    "check": "pnpm typecheck && ../dev/checks/contract && pnpm check:observer-boundary && pnpm check:resource-boundary && pnpm check:react-doctor && pnpm check:konsistent",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "check:diff-worker-bundle": "node scripts/check-review-diff-worker-bundle.mjs",
    "check:resource-boundary": "node --test scripts/resource-boundary.test.mjs && node scripts/check-resource-boundary.mjs",
    "check:observer-boundary": "node scripts/check-observer-boundary.mjs",
    "check:konsistent": "konsistent validate && konsistent check",
    "check:react-doctor": "react-doctor --blocking warning --no-score --yes",
    "generate:api-contract": "node scripts/generate-api-contract.mjs",
    "test": "node scripts/prepare-test-output.mjs && tsc -p tsconfig.test.json && TZ=UTC node --test \".test-output/**/*.test.js\"",
    "test:smoke": "node --test \"smoke/**/*.spec.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.4.5",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/commit-mono": "5.3.0",
    "@pierre/diffs": "1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "github-slugger": "2.0.0",
    "lucide-react": "^0.562.0",
    "mdast-util-from-markdown": "2.0.3",
    "motion": "^12.42.2",
    "pagent": "file:vendor/pagent-v0.1.0-47b796c.tgz",
    "posthog-js": "1.417.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "8.20.0",
    "konsistent": "1.0.0-beta.1",
    "nitro": "^3.0.260311-beta",
    "playwright": "1.61.1",
    "react-doctor": "^0.5.8",
    "typescript": "^6.0.2",
    "vite": "^8.0.14"
  }
}
